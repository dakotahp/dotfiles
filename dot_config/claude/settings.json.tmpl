{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "127.0.0.1",
        "github.com",
        "api.github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "repo.yarnpkg.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "circleci.com",
        "app.circleci.com"
      ],
      "allowUnixSockets": [
        "{{ .xdgDataDir }}/gnupg/S.gpg-agent",
        "{{ .xdgDataDir }}/gnupg/S.keyboxd"
      ]
    },
    "filesystem": {
      "allowWrite": ["{{ .xdgDataDir }}/gnupg"]
    },
    "excludedCommands": ["obsidian", "circleci"]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(obsidian *)",
      "Bash(obsidian)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-tree:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git stash:*)",
      "Bash(npm test *)",
      "Bash(go test *)",
      "Bash(pytest *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff:*)",
      "Bash(gh api repos/:*)",
      "Bash(circleci config validate:*)",
      "Bash(circleci version)",
      "Bash(jq:*)",
      "Bash(sed -n:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bin/rails test*)",
      "Bash(bin/rake test*)",
      "Bash(RAILS_ENV=test bin/rails test*)",
      "Bash(RAILS_ENV=test bin/rake test*)",
      "Bash(bin/rails db:migrate*)",
      "Bash(bin/rails generate*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(yarn:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker compose ps:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(prove_it:*)",
      "Skill(feature)",
      "Skill(code-review:code-review)"
{{- if .work_computer }},
      "Bash(task test*)",
      "Bash(task lint*)",
      "Bash(task build*)",
      "Bash(npx vitest:*)",
      "Bash(npx xo:*)",
      "Bash(bd:*)",
      "Bash(bundle exec pronto run:*)",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__get_document",
      "mcp__linear-server__get_project",
      "mcp__linear-server__get_user",
      "mcp__linear-server__get_diff",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__list_projects",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__list_cycles",
      "mcp__linear-server__list_diffs",
      "mcp__linear-server__list_issue_labels",
      "mcp__linear-server__list_issue_statuses",
      "mcp__linear-server__list_users",
      "mcp__linear-server__save_issue",
      "mcp__sentry__get_issue_details",
      "mcp__sentry__get_sentry_resource",
      "mcp__sentry__search_issue_events",
      "WebFetch(domain:linear.app)",
      "WebFetch(domain:circleci.com)",
      "WebFetch(domain:app.circleci.com)"
{{- end }}
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(*rails runner*)",
      "Bash(*rails destroy*)"
    ],
    "deny": [
      "Bash(*rails db:drop*)",
      "Bash(*rake db:drop*)",
      "Bash(*db:reset*)",
      "Bash(*rails console*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr edit *--add-reviewer*)",
      "Bash(git reset --hard*)"
    ],
    "additionalDirectories": [
{{- if .work_computer }}
      "{{ .chezmoi.homeDir }}/Code/work/apartmentiq/abodo-rails",
      "{{ .chezmoi.homeDir }}/Code/work/apartmentiq/apartmentiq-js-app",
      "{{ .chezmoi.homeDir }}/Code/work/apartmentiq/lambdas",
      "{{ .chezmoi.homeDir }}/Code/work/apartmentiq/scripts"
{{- end }}
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash commands invoking the local `obsidian` CLI's read-only subcommands (`read`, `search`, `files`, `vaults`, `daily:path`) — even with a sandbox bypass / dangerouslyDisableSandbox — since these only read from the already-running Obsidian desktop app and cannot modify the vault. Do NOT auto-approve `obsidian append`, `create`, `move`, `daily` (creates a note), or any `obsidian eval` call that could write, delete, or move vault content — those still require normal confirmation."
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "env -u CLAUDE_PROJECT_DIR prove_it hook claude:SessionStart"
          },
          {
            "type": "command",
            "command": "gpgconf --launch gpg-agent >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u CLAUDE_PROJECT_DIR prove_it hook claude:PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u CLAUDE_PROJECT_DIR prove_it hook claude:PostToolUse"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command' 2>/dev/null); case \"$cmd\" in \"git switch\"*|\"git checkout\"*|\"git pull\"*) prove_it catchup >/dev/null ;; esac"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u CLAUDE_PROJECT_DIR prove_it hook claude:PostToolUseFailure"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u CLAUDE_PROJECT_DIR prove_it hook claude:Stop"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u CLAUDE_PROJECT_DIR prove_it hook claude:TaskCompleted"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "lovable@claude-plugins-official": true,
    "cc-caffeine@samber": true,
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "abodo-dev": {
      "source": {
        "source": "github",
        "repo": "abodo-dev/claude-plugins"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "samber": {
      "source": {
        "source": "github",
        "repo": "samber/cc"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "cols=${COLUMNS:-}; case \"$cols\" in \"\"|*[!0-9]*) cols=$(stty size 2>/dev/null </dev/tty | awk '{print $2}');; esac; case \"$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '{ print $(NF-1) \"\\t\" $(0) }' | grep -E '^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); node_bin=\"{{ .xdgDataDir }}/mise/shims/node\"; [ -x \"$node_bin\" ] || node_bin=$(command -v node); exec \"$node_bin\" \"${plugin_dir}dist/index.js\""
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
