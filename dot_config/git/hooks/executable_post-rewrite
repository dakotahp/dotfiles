#!/bin/bash

if [[ "$1" != "rebase" ]]; then
  exit 0
fi

# prove_it measures churn against refs that do not move with the branch, so after
# a rebase it treats the new base's commits as unreviewed changes.
git for-each-ref --format='%(refname)' refs/worktree/prove_it/ | while read -r ref; do
  git update-ref -d "$ref"
done
