# Claude Code snapshots PATH at launch and runs its Bash tool in non-interactive
# shells that never re-source .zshrc, so `mise activate` never fires for agent
# commands. Prepending the shims dir lets mise resolve each repo's pinned tool
# versions without a per-command `export PATH=...`, which the permission
# allowlist cannot match.
claude() {
  if [[ -d "$HOME/.local/share/mise/shims" ]]; then
    PATH="$HOME/.local/share/mise/shims:$PATH" command claude "$@"
  else
    command claude "$@"
  fi
}
